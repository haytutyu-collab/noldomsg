  enriched.sort((a, b) => {
    if (a.lastMessage && b.lastMessage) {
      return b.lastMessage.createdAt.getTime() - a.lastMessage.createdAt.getTime()
    }
    if (a.lastMessage) return -1
    if (b.lastMessage) return 1
    return a.name.localeCompare(b.name)
