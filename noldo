        {/* Local video preview (small, top-right) */}
        {isVideo && (
          <video
            ref={localVideoRef}
            autoPlay
            playsInline
            muted
            className="absolute top-3 right-3 w-28 h-40 object-cover rounded-lg border-2 border-white/30 shadow-lg"
          />
